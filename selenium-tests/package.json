{
    "name": "spendagent-selenium-tests",
    "version": "1.0.0",
    "private": true,
    "description": "Selenium E2E tests for the SpendAgent live GitHub Pages site",
    "scripts": {
          "test": "mocha tests/*.test.js --timeout 30000 --reporter mochawesome --reporter-options reportDir=mochawesome-report,reportFilename=report",
          "test:local": "cross-env SITE_URL=http://localhost:5500 mocha tests/*.test.js --timeout 30000"
    },
    "devDependencies": {
          "cross-env": "^7.0.3",
          "mocha": "^10.4.0",
          "mochawesome": "^7.1.3",
          "selenium-webdriver": "^4.20.0"
    }
}
